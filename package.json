{
  "name": "physicalai",
  "private": true,
  "version": "0.1.0",
  "description": "PhysicalAI - root launcher delegating to the dashboard frontend and FastAPI backend",
  "scripts": {
    "dev": "npm --prefix dashboard run dev",
    "build": "npm --prefix dashboard run build",
    "test": "npm --prefix dashboard run test",
    "install:dashboard": "npm --prefix dashboard install",
    "install:pipeline": "pip install -r requirements.txt",
    "backend": "cross-env MOCK_PIPELINE=true python -m uvicorn api.main:app --reload --port 8000",
    "backend:real": "cross-env MOCK_PIPELINE=false python -m uvicorn api.main:app --reload --port 8000"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
