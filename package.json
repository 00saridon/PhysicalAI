{
  "name": "physicalai",
  "private": true,
  "version": "0.1.0",
  "description": "PhysicalAI - root launcher delegating to the dashboard frontend and FastAPI backend",
  "scripts": {
    "dev": "npm --prefix dashboard run dev",
    "build": "npm --prefix dashboard run build",
    "test": "npm --prefix dashboard run test",
    "install:dashboard": "npm --prefix dashboard install",
    "backend": "python -m uvicorn api.main:app --reload --port 8000"
  }
}
